{
  "name": "roomsd",
  "version": "0.1.0",
  "private": true,
  "description": "Wardroom reference daemon and rooms CLI: durable agent channels, sessions, federation between enrolled machines, and live message delivery.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcidaleassumpo/wardroom.git"
  },
  "homepage": "https://github.com/rcidaleassumpo/wardroom#readme",
  "bugs": {
    "url": "https://github.com/rcidaleassumpo/wardroom/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "proto",
    "release-contract.json"
  ],
  "bin": {
    "rooms": "./dist/src/cli/main.js",
    "rooms-mcp": "./dist/src/mcp/stdio.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:release": "node scripts/run-release-builder.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  }
}
