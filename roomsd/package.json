{
  "name": "wardroom",
  "version": "0.1.0",
  "private": true,
  "description": "Wardroom reference daemon and rooms CLI for durable agent channels, sessions, and live message delivery.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcidaleassumpo/wardroom.git"
  },
  "homepage": "https://github.com/rcidaleassumpo/wardroom#readme",
  "bugs": {
    "url": "https://github.com/rcidaleassumpo/wardroom/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "proto",
    "release-contract.json"
  ],
  "bin": {
    "rooms": "./dist/src/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:release": "node scripts/build-release.mjs",
    "package:distributions": "node scripts/package-distributions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
